# Copy to .env.local and fill in. Never commit real values.

# --- Public (inlined into the browser bundle; safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (required at runtime; set on Vercel as Sensitive) ---
# !!! SUPABASE_SERVICE_ROLE_KEY bypasses row level security. It is used by the API
# !!! routes on the server and by `npm run seed`. NEVER prefix it with NEXT_PUBLIC_,
# !!! never import it in client code, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Without a key the rule-based fallback is used.
GEMINI_API_KEY=
# Optional. Default: gemini-2.5-flash
GEMINI_MODEL=

# --- LOCAL-ONLY secret (Supabase CLI) ---
# NEVER set this on Vercel.
SUPABASE_DB_PASSWORD=
